# Local PostgreSQL (docker compose --env-file .env.local up -d postgres)
LOCAL_DB_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://blog:replace-with-a-random-local-password@127.0.0.1:5433/blog_studio
# Explicit migrations by default; never enable schema push against production.
DATABASE_PUSH=false
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-a-different-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production: replace DATABASE_URL with Neon; use separate resources for preview.
# BLOB_READ_WRITE_TOKEN=
# BLOB_PUBLIC_HOST=your-store.public.blob.vercel-storage.com

# Supply only when running pnpm bootstrap; not needed by the web server.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
