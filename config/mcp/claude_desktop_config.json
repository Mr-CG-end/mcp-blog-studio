{
  "mcpServers": {
    "blog-studio": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:3000/mcp",
        "--header",
        "Authorization: Bearer ${MCP_TOKEN}"
      ],
      "env": { "MCP_TOKEN": "REPLACE_WITH_PERSONAL_MCP_KEY" }
    }
  }
}
